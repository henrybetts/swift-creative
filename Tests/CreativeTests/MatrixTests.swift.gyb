%   components = all_components[:n]
%   f = fixtures[n]
%   a, b = f['a'], f['b']
%   v = list(range(1, n + 1))
%{
def vec(values):
    return '%s(%s)' % (vector, args(values))

def matrix(rows):
    return '%s(rows: (%s))' % (type, ', '.join(vec(row) for row in rows))
}%

