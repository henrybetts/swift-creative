    @Test func addition() {
        #expect(a + b == ${type}(${args([x + y for x, y in zip(a, b)])}))
    }

    @Test func subtraction() {
        #expect(b - a == ${type}(${args([y - x for x, y in zip(a, b)])}))
    }

    @Test func scalarMultiplicationAndDivision() {
        #expect(a * 2 == ${type}(${args([x * 2 for x in a])}))
        #expect(2 * a == a * 2)
        #expect(a / 2 == ${type}(${args([x / 2 for x in a])}))
    }

    @Test func componentWiseMultiplicationAndDivision() {
        let product = ${type}(${args([x * y for x, y in zip(a, b)])})
        #expect(a * b == product)
        #expect(product / a == b)
    }

    @Test func vectorAdditionAndSubtraction() {
        #expect(a + v == ${type}(${args([x + y for x, y in zip(a, b)])}))
        #expect(a - v == ${type}(${args([x - y for x, y in zip(a, b)])}))
    }

    @Test func compoundAssignment() {
        var size = a
        size += b
        size -= a
        #expect(size == b)
        size *= 2
        size /= 2
        #expect(size == b)
        size *= a
        size /= a
        #expect(size == b)
        size += v
        size -= v
        #expect(size == b)
    }

    @Test func vectorConversion() {
        #expect(${vector}(a) == ${vector}(${args(a)}))
        #expect(${type}(v) == b)
